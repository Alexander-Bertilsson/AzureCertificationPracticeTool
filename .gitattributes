# Force LF line endings on all text files across platforms.
# Prevents Windows CRLF drift and matches .editorconfig + Prettier endOfLine: lf.
* text=auto eol=lf

# Binary types — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
