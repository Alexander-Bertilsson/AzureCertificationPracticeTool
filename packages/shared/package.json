{
  "name": "@acpt/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas and inferred TypeScript types used by both the API and the web app.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "echo \"no tests yet\" && exit 0",
    "test:coverage": "echo \"no tests yet\" && exit 0",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@acpt/tsconfig": "workspace:*",
    "@types/node": "^20.16.0"
  }
}
