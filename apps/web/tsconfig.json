{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@acpt/tsconfig/react-native.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": [
      "node",
      "jest",
      "expo/types"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "app/**/*",
    "src/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".expo"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    }
  ]
}
