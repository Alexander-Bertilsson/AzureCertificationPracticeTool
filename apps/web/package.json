{
  "name": "@acpt/web",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Expo (managed) web + native app for the Azure Certification Practice Tool.",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@acpt/shared": "workspace:*",
    "@expo/metro-runtime": "~4.0.1",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.20",
    "expo-constants": "~17.0.3",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.13",
    "expo-splash-screen": "~0.29.18",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@acpt/eslint-config": "workspace:*",
    "@acpt/tsconfig": "workspace:*",
    "@babel/core": "^7.25.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.0",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.2",
    "react-test-renderer": "18.3.1"
  }
}
