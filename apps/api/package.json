{
  "name": "@acpt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Azure Certification Practice Tool. Fastify + Mongoose + zod.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@acpt/shared": "workspace:*",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "mongoose": "^8.8.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@acpt/eslint-config": "workspace:*",
    "@acpt/tsconfig": "workspace:*",
    "@swc/core": "^1.9.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2"
  }
}
