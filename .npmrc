auto-install-peers=true
shared-workspace-lockfile=true
link-workspace-packages=deep

# Use npm-style flat hoisting instead of pnpm's strict isolated layout.
# Required for Expo + Metro: Metro's resolver doesn't follow pnpm's
# .pnpm/ symlinks, so transitive deps like @babel/runtime need to be
# discoverable in a flat node_modules. We give up pnpm's phantom-dep
# protection, but the api still gets typecheck + lint + test gates
# that catch the same class of bug at build time.
node-linker=hoisted
